  "sections": [
    {
      "id": "vocab-s01",
      "part": "vocab",
      "heading": {
        "html": "問題1<u>　　</u>のことばの読み方として最もよいものを、1、2、3、4から一つえらびなさい。"
      },
      "items": [
        {
          "id": "vocab-q002",
          "stem": {
            "html": "<u>浅い</u>ほうの容器をください。"
          },
          "options": [
            "まるい",
            "ふかい",
            "かるい",
            "あさい"
          ],
          "key": 4
        },
        {
          "id": "vocab-q004",
          "stem": {
            "html": "この店のチーズは<u>種類</u>が多い。"
          },
          "options": [
            "しゅるい",
            "しゅれい",
            "しゅうるい",
            "しゅうれい"
          ],
          "key": 1
        }
      ]
    },
    {
      "id": "vocab-s02",
      "part": "vocab",
      "heading": {
        "html": "問題2<u>　　</u>のことばを漢字で書くとき、最もよいものを、1、2、3、4から一つえらびなさい。"
      },
      "items": [
        {
          "id": "vocab-q012",
          "stem": {
            "html": "早く<u>つつんで</u>ください。"
          },
          "options": [
            "運んで",
            "結んで",
            "包んで",
            "選んで"
          ],
          "key": 3
        }
      ]
    },
    {
      "id": "vocab-s03",
      "part": "vocab",
      "heading": "問題3（　）に入れるのに最もよいものを、1、2、3、4から一つえらびなさい。",
      "items": [
        {
          "id": "vocab-q016",
          "stem": "昨日友達と行った映画館はとてもすいていて、（　）が多かった。",
          "options": [
            "不要",
            "欠席",
            "不足",
            "空席"
          ],
          "key": 4
        },
        {
          "id": "vocab-q018",
          "stem": "その映画は、内容はよく覚えているが（　）が思い出せない。",
          "options": [
            "フィルム",
            "タイトル",
            "チケット",
            "イメージ"
          ],
          "key": 2
        },
        {
          "id": "vocab-q020",
          "stem": "暗い所から急に明るい所に出たので、（　）目を閉じてしまった。",
          "options": [
            "まぶしくて",
            "きびしくて",
            "めずらしくて",
            "あたたかくて"
          ],
          "key": 1
        }
      ]
    },
    {
      "id": "reading-s01",
      "part": "reading",
      "heading": "問題1つぎの文の（　）に入れるのに最もよいものを、1、2、3、4から一つえらびなさい。",
      "items": [
        {
          "id": "reading-q004",
          "stem": "3か月前から週に2回、コンビニでアルバイトをしている。覚えることが多くて最初は大変だったが、（　）仕事に慣れてきた。",
          "options": [
            "結局",
            "さっき",
            "今にも",
            "ようやく"
          ],
          "key": 4
        },
        {
          "id": "reading-q005",
          "stem": "うちの近くにあるラーメン屋は、とても人気があって、いつ食べに（　）込んでいる。",
          "options": [
            "行って",
            "行けば",
            "行っても",
            "行くのに"
          ],
          "key": 3
        },
        {
          "id": "reading-q006",
          "stem": "妹は飛行機が好きだ。飛行機を見る（　）毎週空港へ通っている。",
          "options": [
            "ときだけに",
            "ためだけに",
            "ときにしか",
            "ためにしか"
          ],
          "key": 2
        },
        {
          "id": "reading-q007",
          "stem": {
            "html": "「駅前のパン屋がセールしているって知っていた？」<br>「ううん、パン屋が（　）知らなかったよ。」"
          },
          "options": [
            "できたのも",
            "できたのは",
            "できるのか",
            "できるのを"
          ],
          "key": 1
        },
        {
          "id": "reading-q008",
          "stem": "「山下先生、お久しぶりです。また先生に（　）うれしいです。」",
          "options": [
            "拝見できて",
            "ごらんになれて",
            "お目にかかれて",
            "お会いになれて"
          ],
          "key": 3
        },
        {
          "id": "reading-q009",
          "stem": "昨日美容院に行ったのだが、予約した時間に着いたのに、30分以上（　）。",
          "options": [
            "待たれた",
            "待たされた",
            "待たせていった",
            "待ってくれた"
          ],
          "key": 2
        },
        {
          "id": "reading-q011",
          "stem": "革の靴にこのクリームを塗ると、汚れが（　）。",
          "options": [
            "つかなくする",
            "つきにくくなる",
            "つかなくてもいい",
            "つきにくいほうがいい"
          ],
          "key": 2
        },
        {
          "id": "reading-q012",
          "stem": "「この荷物、私たちだけで倉庫まで運ぶのは大変ですね。山野さんにも（　）。」",
          "options": [
            "手伝ってあげましょうか",
            "手伝ってあげられませんか",
            "手伝ってもらいましょうか",
            "手伝ってもらえませんか"
          ],
          "key": 3
        },
        {
          "id": "reading-q013",
          "stem": "私は毎年東山公園で行われる夏祭りに行くのを楽しみにしているのだが、今年はその時期に海外出張の予定があって、（　）。",
          "options": [
            "行けそうにない",
            "行けるに違いない",
            "行ってもしかたがない",
            "行ってもかまわない"
          ],
          "key": 1
        }
      ]
    },
    {
